{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/fukuoka",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fukuoka/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fukuoka/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cebu",
      "destination": "/cebu/",
      "permanent": false
    },
    {
      "source": "/okinawa",
      "destination": "/okinawa/",
      "permanent": false
    },
    {
      "source": "/samcheok",
      "destination": "/samcheok/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/cebu/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/okinawa/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/samcheok/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
